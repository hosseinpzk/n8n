    {
      "parameters": {
        "jsCode": "const contactNode = $node[\"HubSpot_Get_Contact\"].json || {};\nconst extract = $node[\"Code_Extract_ContactId\"].json || {};\nconst companiesRes = $node[\"HTTP_Get_Contact_Companies\"].json || {};\nconst dealsRes = $node[\"HTTP_Get_Contact_Deals\"].json || {};\n\nconst contact = contactNode.properties || contactNode;\nconst mode = extract.mode || \"summary\";\n\nconst companies = Array.isArray(companiesRes.results) ? companiesRes.results : [];\nconst deals = Array.isArray(dealsRes.results) ? dealsRes.results : [];\n\nconst context = `\nCONTACT\nFirst name: ${contact.firstname || \"\"}\nLast name: ${contact.lastname || \"\"}\nEmail: ${contact.email || \"\"}\nJob title: ${contact.jobtitle || \"\"}\nPhone: ${contact.phone || \"\"}\nLead status: ${contact.hs_lead_status || \"\"}\n\nASSOCIATED COMPANIES\nCount: ${companies.length}\n\nASSOCIATED DEALS\nCount: ${deals.length}\n`;\n\nlet aiPrompt = \"\";\n\nif (mode === \"summary\") {\n  aiPrompt = `\nYou are a senior B2G education sales strategist working for Magrid.\n\nProduce a SHORT contact brief.\n\nReturn only:\n1. Who this contact appears to be\n2. Likely relevance in the buying process\n3. Recommended message angle\n4. Recommended next action\n\nRules:\n- Keep it concise\n- No invented facts\n- Formal and practical tone\n\nContext:\n${context}\n`;\n} else if (mode === \"full\") {\n  aiPrompt = `\nYou are a senior B2G education sales strategist working for Magrid.\n\nAnalyse this contact and provide:\n\n1. Executive Summary\n2. Likely Role in the Organisation\n3. Likely Relevance in the Deal\n4. Influence Hypothesis\n5. Recommended Messaging Angle\n6. Risks / Unknowns\n7. Recommended Next Step\n\nRules:\n- No invented facts\n- Be practical and concrete\n- Formal tone\n\nContext:\n${context}\n`;\n} else {\n  aiPrompt = `\nYou are a senior B2G education sales strategist working for Magrid.\n\nProvide a strategic contact reading.\n\nReturn:\n1. Executive Summary\n2. Likely Institutional Role\n3. Influence in the Buying Process\n4. Relationship to Company / Deal\n5. Best Strategic Angle of Approach\n6. Risks / Unknowns\n7. Immediate Next Action\n\nRules:\n- Formal and strategic tone\n- No invented facts\n- Adapt to ministries, NGOs, school groups, distributors when relevant\n\nContext:\n${context}\n`;\n}\n\nreturn [{\n  json: {\n    contact_context: context,\n    ai_prompt: aiPrompt,\n    mode,\n    record_type: \"contact\"\n  }\n}];"
      },
