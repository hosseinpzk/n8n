    {
      "parameters": {
        "jsCode": "const root = $json || {};\nconst body = root.body && typeof root.body === \"object\" ? root.body : root;\nconst query = root.query && typeof root.query === \"object\" ? root.query : {};\nconst params = root.params && typeof root.params === \"object\" ? root.params : {};\n\nconst rawUrl =\n  body.hubspotUrl ??\n  query.hubspotUrl ??\n  params.hubspotUrl ??\n  \"\";\n\nconst rawMode =\n  body.mode ??\n  query.mode ??\n  params.mode ??\n  \"summary\";\n\nconst hubspotUrl = String(rawUrl || \"\").trim();\nlet mode = String(rawMode || \"summary\").trim().toLowerCase();\n\nif (![\"summary\", \"full\", \"strategy\"].includes(mode)) {\n  mode = \"summary\";\n}\n\nlet contactId = null;\n\nif (hubspotUrl) {\n  const match = hubspotUrl.match(/\\/record\\/0-1\\/(\\d+)/);\n  if (match) {\n    contactId = match[1];\n  }\n}\n\nif (!contactId && hubspotUrl) {\n  const matches = hubspotUrl.match(/\\d{6,}/g);\n  if (matches && matches.length > 0) {\n    contactId = matches[matches.length - 1];\n  }\n}\n\nif (!contactId) {\n  throw new Error(\"Contact ID not found. Provide a valid HubSpot contact URL.\");\n}\n\nreturn [{\n  json: {\n    contactId,\n    hubspotUrl,\n    mode\n  }\n}];"
      },
